{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew :app:compileDebugKotlin *)",
      "Bash(./gradlew :app:detekt *)",
      "Bash(./gradlew :shared:compileAndroidMain *)",
      "Bash(./gradlew :shared:detekt *)",
      "Bash(./gradlew detekt *)",
      "Bash(codex --version *)",
      "Bash(codex --version)",
      "Bash(gh issue view)",
      "Bash(gh issue view:*)",
      "Bash(gh label list *)",
      "Bash(git fetch origin *)",
      "Bash(git fetch origin)",
      "Bash(herdr agent get *)",
      "Bash(herdr agent list *)",
      "Bash(herdr agent list)",
      "Bash(herdr agent read *)",
      "Bash(herdr pane list *)",
      "Bash(herdr pane list)",
      "Bash(herdr pane read *)",
      "Bash(herdr status *)",
      "Bash(herdr status)",
      "Bash(herdr wait *)",
      "Bash(mise --version)",
      "Bash(mise ls*)",
      "Bash(redi issue list *)",
      "Bash(redi issue view *)",
      "Bash(redi project view *)",
      "Bash(redi)",
      "Bash(skills-ref validate *)",
      "Bash(task check *)",
      "Bash(task check:app *)",
      "Bash(task validate *)",
      "Bash(task where *)",
      "Bash(task where)",
      "Edit(.)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(~/.config/redi/config.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/ghq/github.com/kawagh/harness/.rulesync/hooks/block-drawio-url.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccusage statusline"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "language": "Japanese",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
